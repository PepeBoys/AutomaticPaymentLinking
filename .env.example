# Database (SQLAlchemy async URL для подключения к SQLite)
APL_DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3

# Container (параметры запуска Uvicorn внутри контейнера)
APL_HOST=0.0.0.0
APL_PORT=8000
APL_PUBLIC_PORT=8000

# МойСклад API (базовые учетные данные и URL API)
APL_MS_LOGIN=your_login@example.com
APL_MS_PASSWORD=your_password
APL_MS_BASE_URL=https://api.moysklad.ru/api/remap/1.2

# МойСклад Vendor API (параметры интеграции)
APL_MS_APP_ID=
APL_MS_APP_UID=
APL_MS_VENDOR_SECRET_KEY=
APL_VENDOR_API_ENDPOINT_BASE=

# Webhooks (URL для вебхуков и настройки HTTP-клиента)
APL_MS_WEBHOOK_URL=https://your-domain.com/api/hooks/moysklad/webhook
# Таймаут запросов к API МойСклад в секундах (HTTP timeout)
APL_WEBHOOK_TIMEOUT=30
# Количество попыток при ошибках HTTP через tenacity
APL_WEBHOOK_RETRY_ATTEMPTS=3

# Security (ограничение источников CORS и лимит запросов)
# Список origins для CORS (JSON-массив строк)
APL_ALLOWED_ORIGINS='["http://localhost:3000","https://your-domain.com"]'
# Максимум запросов в минуту на одного клиента
APL_API_RATE_LIMIT=100

# Logging (уровень и формат логов)
APL_LOG_LEVEL=INFO
APL_LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
